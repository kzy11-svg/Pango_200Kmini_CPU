<?xml version="1.0" encoding="UTF-8"?>
<ip_inst>
    <header>
        <vendor>Pango</vendor>
        <id>06200602</id>
        <display_name>Jtag_Hub</display_name>
        <name>Jtag_Hub</name>
        <version>1.3</version>
        <instance>R2_TRACE_HUB</instance>
        <family>Logos2</family>
        <device>PG2L200H</device>
        <package>FBB676</package>
        <speedgrade>-6</speedgrade>
        <generator version="2022.2-SP6.4" build="146967">IP Compiler</generator>
    </header>
    <param_list>
        <param>
            <name>CTRL_PORT_NUM</name>
            <value>1</value>
        </param>
        <param>
            <name>UJTAG_SEL</name>
            <value>0</value>
        </param>
        <param>
            <name>UJTAG_SEL_TEXT</name>
            <value>Default JTAG</value>
        </param>
        <param>
            <name>PGT_DEVICE_30G</name>
            <value>false</value>
        </param>
        <param>
            <name>PGT_DEVICE</name>
            <value>false</value>
        </param>
        <param>
            <name>PGL_DEVICE</name>
            <value>false</value>
        </param>
    </param_list>
    <file_list>
        <output>
            <file pathname="generate.log" format="log" description="Generate Log"/>
            <file pathname="R2_TRACE_HUB_tmpl.v" format="verilog" description="Instantiation Template"/>
            <file pathname="R2_TRACE_HUB_tmpl.vhdl" format="vhdl" description="Instantiation Template"/>
        </output>
        <source>
            <file pathname="rtl/ips_jtag_hub_v1_3.v"/>
            <file pathname="R2_TRACE_HUB.v"/>
        </source>
    </file_list>
</ip_inst>

define_attribute {p:i_reset_n} {PAP_IO_LOC} {C22}
define_attribute {p:i_reset_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:i_reset_n} {PAP_IO_STANDARD} {LVCMOS33}

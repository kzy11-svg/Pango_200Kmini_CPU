# MES2L676-CORE-V1.4 / MES-PG2L676-Mini Base-V1.0
# Source: mini-base pin mapping spreadsheet and vendor PDS examples.

create_clock -name {board_27m} [get_ports {i_clk_27m}] -period {37.037} -waveform {0.000 18.5185}
create_generated_clock -name {counter_50m} -source [get_ports {i_clk_27m}] [get_pins {ref_pll_inst/clkout0}] -master_clock [get_clocks {board_27m}] -multiply_by {50} -divide_by {27}
create_generated_clock -name {cpu_120m} -source [get_pins {ref_pll_inst/clkout0}] [get_pins {cpu_pll_inst/clkout0}] -master_clock [get_clocks {counter_50m}] -multiply_by {12} -divide_by {5}

# The original top crosses CPU and counter/UART domains via synchronizers/FIFO.
set_clock_groups -asynchronous -group [get_clocks {cpu_120m}] -group [get_clocks {counter_50m}]

define_attribute {p:i_clk_27m} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:i_clk_27m} {PAP_IO_LOC} {E17}
define_attribute {p:i_clk_27m} {PAP_IO_VCCIO} {3.3}
define_attribute {p:i_clk_27m} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:i_clk_27m} {PAP_IO_NONE} {TRUE}

